APP_NAME=Omega286
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://127.0.0.1:2080 — Produção Hostinger (com /public na URL): https://seu-dominio/public
APP_URL=http://localhost
# Hostinger (document root na raiz, URL com /public/): em production já é true por padrão
# APP_FORCE_PUBLIC_URL=false
# Só se o document root for omegaadm/public (sem /public na URL)
# Após git pull em produção: npm ci && npm run build  (atualiza public/build — obrigatório para o layout)
# Diagnóstico: php artisan assets:diagnostico --curl
AFD_EMPRESA_CNPJ=
AFD_EMPRESA_RAZAO_SOCIAL=
EMPRESA_NOME_FANTASIA=OMEGA SERVICE
APP_INSTALLED=false
PGU_EXPORT_CHROME_PATH=
PGU_EXPORT_PHP_BINARY=
PGU_CAPTURE_BASE_URL=
PGU_CAPTURE_HOST=127.0.0.1
PGU_CAPTURE_AUX_PORT=
PGU_CAPTURE_AUX_PORT_START=56080
PGU_CAPTURE_AUX_PORT_END=56150
PGU_EXPORT_TIMEOUT=180
PGU_EXPORT_SCALE=2
PGU_EXPORT_KEEP_FILES=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omega286
DB_USERNAME=omega286
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_BRAND_NAME="Omega Adm CT 286"
MAIL_AUTH_EMAILS_ENABLED=true

# Cópia automática (mailer padrão do sistema) ao enviar solicitação de adesão à Matriz
MAIL_BENEFICIO_NOTIFICACAO_INTERNA_JARBAS=jarbas.alves@omegaservice.com.br
MAIL_BENEFICIO_ADESAO_COPIA_JARBAS=jarbas.alves@omegaservice.com.br

# SMTP Zimbra — e-mail à Matriz como se Jarbas enviasse (senha de aplicativo, não a senha normal)
MAIL_ZIMBRA_HOST=smtp.omegaservice.com.br
MAIL_ZIMBRA_PORT=587
MAIL_ZIMBRA_ENCRYPTION=tls
MAIL_ZIMBRA_USERNAME=jarbas.alves@omegaservice.com.br
MAIL_ZIMBRA_PASSWORD=
MAIL_ZIMBRA_FROM_ADDRESS=jarbas.alves@omegaservice.com.br
MAIL_ZIMBRA_FROM_NAME="Jarbas Alves de Carvalho e Silva"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
